rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // App uses local (client-side) username/password auth + Firebase Anonymous
    // Auth purely to satisfy these rules. isAuth() does NOT mean "passed the
    // in-app login screen" — signInAnonymously() runs unconditionally as soon
    // as the page loads (componentDidMount), before any login form is shown or
    // submitted. Every visitor becomes isAuth()==true within about a second of
    // opening the URL. All role/permission checks (admin-only actions, PIN
    // gates, etc.) are enforced ONLY in client JS, not by these rules — a
    // visitor with browser devtools can read/write any collection below
    // (including users' password hashes and role fields) without ever logging
    // in. This is a deliberate, accepted trade-off for this app's size and
    // deployment model, not an oversight — but do not write rules or app code
    // that assumes isAuth() implies a real authenticated identity or role.
    function isAuth() { return request.auth != null; }

    // boxes/box_drugs are never deleted by the app (only edited in place) —
    // block delete so a future bug or bad anon write can't wipe a box record.
    match /boxes/{boxId} {
      allow read, create, update: if isAuth();
      allow delete: if false;
    }
    match /box_drugs/{boxId} {
      allow read, create, update: if isAuth();
      allow delete: if false;
    }
    // audit_log is append-only — the app only ever calls .add(), never edits
    // or removes a historical entry. Blocking update/delete keeps the audit
    // trail tamper-proof even against a future client-side bug.
    match /audit_log/{entryId} {
      allow read, create: if isAuth();
      allow update, delete: if false;
    }
    // usage_log: the paperless per-use drug log written from the public QR
    // page (dept PIN gated at the UI layer). Append-only for the same reason
    // as audit_log — a real usage record must never be editable or erasable.
    match /usage_log/{entryId} {
      allow read, create: if isAuth();
      allow update, delete: if false;
    }
    // users legitimately supports delete (admin "remove account" feature).
    match /users/{userId} {
      allow read, write: if isAuth();
    }
    match /app_settings/{docId} {
      allow read, create, update: if isAuth();
      allow delete: if false;
    }
    // kpi_events: append-only instrumentation feeding the admin-only KPI
    // dashboard (expiry incidents, registration timing, audit write
    // failures) — written by the daily check-expiry.js Action (via the
    // Admin SDK, which bypasses these rules entirely) and by the app itself.
    // Same append-only rationale as audit_log/usage_log: a KPI history must
    // not be editable after the fact.
    match /kpi_events/{entryId} {
      allow read, create: if isAuth();
      allow update, delete: if false;
    }
    // kpi_investigations: admin's manual log of audit-trail investigations
    // (KPI 4.2) — append-only for the same reason; a correction is added as
    // a new entry rather than editing history.
    match /kpi_investigations/{entryId} {
      allow read, create: if isAuth();
      allow update, delete: if false;
    }
    // expiry_actions: closes the loop on a near-expiry/expired LINE alert —
    // one doc per (box, drug, lot expiry) "incident", tracking whether a
    // pharmacist has acknowledged it and, later, what concrete action was
    // taken (used before expiry, swapped the lot, disposed, returned to
    // supplier, etc.). Unlike audit_log/kpi_events this is NOT append-only —
    // the same incident's status legitimately transitions
    // none -> acknowledged -> resolved as work happens, same "ticket" shape
    // as a box document itself. Delete is still blocked so a resolved
    // incident's record can't be wiped after the fact; a correction is a new
    // update (status can move back to 'acknowledged' if a resolution needs
    // revising), never a deletion.
    match /expiry_actions/{incidentId} {
      allow read, create, update: if isAuth();
      allow delete: if false;
    }
    // box_open_actions: closes the loop on a "box opened" LINE alert (fired
    // by usage-alert.yml the moment a ward's first paperless usage-log entry
    // lands on a dispensed box) — one doc per (box, openedAt) opening event,
    // tracking whether the pharmacy has acknowledged it and, later, whether
    // a replacement box was actually prepared/swapped in. Same non-append-only
    // "ticket" shape as expiry_actions, for the same reason: the status
    // legitimately transitions none -> acknowledged -> resolved as real work
    // happens. Delete is still blocked so a resolved record can't be wiped.
    match /box_open_actions/{incidentId} {
      allow read, create, update: if isAuth();
      allow delete: if false;
    }
  }
}
