rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // App uses local auth + Firebase Anonymous Auth
    // request.auth != null means the browser has signed in anonymously (= local login passed)
    function isAuth() { return request.auth != null; }

    match /boxes/{boxId} {
      allow read, write: if isAuth();
    }
    match /box_drugs/{boxId} {
      allow read, write: if isAuth();
    }
    match /audit_log/{entryId} {
      allow read, write: if isAuth();
    }
    match /users/{userId} {
      allow read, write: if isAuth();
    }
    match /app_settings/{docId} {
      allow read, write: if isAuth();
    }
  }
}
