rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuth() { return request.auth != null; }
    function userRole() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role; }
    function isAdmin() { return isAuth() && userRole() == 'admin'; }
    function isPharmacist() { return isAuth() && (userRole() == 'pharmacist' || userRole() == 'admin'); }
    match /boxes/{boxId} {
      allow read: if isAuth();
      allow write: if isPharmacist();
    }
    match /box_drugs/{boxId} {
      allow read: if isAuth();
      allow write: if isPharmacist();
    }
    match /audit_log/{entryId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update, delete: if isAdmin();
    }
    match /users/{userId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }
  }
}
